{
  "name": "@ankhorage/data-sources",
  "type": "module",
  "version": "2.0.2",
  "description": "Headless toolkit for importing, normalizing, and executing canonical Ankhorage API and data-source configs.",
  "homepage": "https://github.com/ankhorage/data-sources#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/data-sources/issues"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/data-sources.git"
  },
  "keywords": [
    "ankhorage",
    "data-sources",
    "api",
    "openapi",
    "graphql",
    "rest",
    "typescript"
  ],
  "dependencies": {
    "@ankhorage/contracts": "^8.1.0"
  },
  "ankh": {
    "category": "data-sources",
    "provider": "./dist/cli/index.js",
    "capabilities": [
      "data-sources.inspect",
      "data-sources.validate",
      "data-sources.test",
      "data-sources.normalize"
    ]
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "browser": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.build.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "paradox",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "prepack": "bun run build",
    "test": "bun test src",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "version-packages": "ankhorage-changeset version",
    "knip:check": "ankhorage-knip"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.10.6",
    "@ankhorage/paradox": "^0.1.24",
    "@types/bun": "^1.4.0",
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.0"
}
